# ChatGPT -> MCP embedded OAuth 2.1 authorization server.
MCP_AUTH_MODE=oauth
MCP_PUBLIC_BASE_URL=https://mp-gsc-mcp-REPLACE.a.run.app
MCP_REQUIRED_SCOPES=gsc.read

# Owner accounts allowed to approve ChatGPT linking. Separate multiple values with commas.
OAUTH_ALLOWED_EMAILS=ben@example.com

# Public-client callbacks accepted by dynamic client registration.
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,.openai.com

# Token lifetimes in seconds.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_DYNAMIC_CLIENT_TTL_SECONDS=31536000

# Do not put either secret in this file. Mount both from Google Secret Manager:
# OAUTH_TOKEN_SECRET: at least 32 random bytes, for example `openssl rand -base64 48`
# OAUTH_ADMIN_PASSWORD: a strong password used on the authorization page

# Optional local shared-secret auth mode (GA4-style, no external JWKS).
# Set MCP_AUTH_MODE=oauth_local and use ONE of these secrets:
# MCP_OAUTH_TOKEN_SECRET=replace-with-long-random-secret
# OAUTH_TOKEN_SECRET=replace-with-long-random-secret
# Optional: restrict token email claim
# OAUTH_ALLOWED_EMAILS=you@example.com,admin@example.com

# Exact GSC property identifiers. Separate multiple values with commas.
GSC_ALLOWED_PROPERTIES=sc-domain:makeuppalace.com.au
MCP_REQUIRE_PROPERTY_ALLOWLIST=true

# Google Search Console API authentication. Cloud Run uses its attached service account.
GSC_GOOGLE_AUTH_MODE=adc
GSC_SKIP_OAUTH=true

# HTTP runtime.
PORT=8080
MCP_HOST=0.0.0.0
MCP_HTTP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
MCP_READINESS_CHECK_GSC=false

# Optional origin overrides. They must be absolute HTTPS origins without a path.
# OAUTH_ISSUER_URL=https://gsc-mcp.example.com
# OAUTH_RESOURCE_URL=https://gsc-mcp.example.com

# Optional additional Host/Origin patterns for custom domains or local tunnels.
# MCP_ALLOWED_HOSTS=mp-gsc.example.com,mp-gsc.example.com:*
# MCP_ALLOWED_ORIGINS=https://mp-gsc.example.com

# Existing external IdP/JWKS deployments remain available with:
# MCP_AUTH_MODE=external_jwt
# MCP_OAUTH_ISSUER=https://YOUR-OAUTH-ISSUER.example.com/
# MCP_OAUTH_JWKS_URI=https://YOUR-OAUTH-ISSUER.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mp-gsc-mcp-REPLACE.a.run.app
# MCP_OAUTH_ALGORITHMS=RS256
